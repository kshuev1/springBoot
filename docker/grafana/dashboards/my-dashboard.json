      "id": 1,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "name": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
